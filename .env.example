# Copia este archivo como .env y rellénalo. El .env NUNCA se sube a GitHub.

# Telegram (token de @BotFather; el chat ID te lo dice el bot con /start)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Enable Banking
EB_APP_ID=
EB_KEY_PATH=tu-application-id.pem
EB_COUNTRY=ES
EB_REDIRECT_URL=https://localhost/callback
# Lo rellena solo conectar_banco.py
EB_SESSION_ID=

# Hora local para el envío de las 00:00
ZONA_HORARIA=Europe/Madrid
