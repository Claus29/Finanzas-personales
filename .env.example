# Copia este archivo como .env y rellénalo. El .env NUNCA se sube a GitHub.
# El asistente de la ventana del bot lo rellena solo la primera vez.

# Telegram (token de @BotFather; el chat ID lo detecta el asistente)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Enable Banking
EB_APP_ID=
EB_KEY_PATH=
EB_COUNTRY=ES
EB_REDIRECT_URL=
# Lo rellena la autenticación con N26
EB_SESSION_ID=

# Ajustes (se cambian desde «⚙️ Ajustes» en Telegram)
LIMITE_CONSULTAS_DIA=4
# Hora de la actualización diaria con el banco (en silencio)
HORA_SALDO_DIARIO=00:00
SALDO_DIARIO_ACTIVO=1
ZONA_HORARIA=Europe/Madrid
# Días del mes en que sueles cobrar (recordatorio del cobro)
DIA_COBRO_DESDE=3
DIA_COBRO_HASTA=7
# Presupuesto de gasto por ciclo (0 = sin límite) y aviso de saldo neto bajo (0 = sin aviso)
PRESUPUESTO_CICLO=0
UMBRAL_SALDO_BAJO=300
# (v6, sin uso desde la v7) Hora del recordatorio el día de pago
HORA_AVISO_PAGO=00:00
# Recordatorios de deudas repartidos en esta franja del día
FRANJA_DEUDAS_DESDE=08:00
FRANJA_DEUDAS_HASTA=14:00
# Lo que te deben sin día fijo: días del mes en que te pregunto si te han pagado
DIAS_AVISO_SIN_DIA=5,15,25
# Colchón de emergencia (se activa desde Ajustes): 1 = activado; meses de gastos a cubrir
COLCHON_ACTIVO=0
COLCHON_MESES=3
# Proyección: salario estimado (0 = el último cobrado) y mes final (AAAA-MM; vacío = 12 cobros)
SALARIO_ESTIMADO=0
PROYECCION_HASTA=
# Avisos automáticos (1 = activado, 0 = desactivado)
AVISO_DEUDAS=1
AVISO_ME_DEBEN=1
AVISO_METAS=1
AVISO_RESUMEN_SEMANAL=1
AVISO_RESUMEN_CICLO=1
AVISO_SALDO_BAJO=1
AVISO_RITMO=1
AVISO_GASTO_GRANDE=1
AVISO_SUSCRIPCIONES=0
