# Copia este archivo como .env y rellénalo. El .env NUNCA se sube a GitHub.
# El asistente de la ventana del bot lo rellena solo la primera vez.

# Telegram (token de @BotFather; el chat ID lo detecta el asistente)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Enable Banking
EB_APP_ID=
EB_KEY_PATH=
EB_COUNTRY=ES
EB_REDIRECT_URL=
# Lo rellena la autenticación con N26
EB_SESSION_ID=

# Ajustes (se cambian desde «⚙️ Ajustes» en Telegram)
LIMITE_CONSULTAS_DIA=4
HORA_SALDO_DIARIO=00:00
SALDO_DIARIO_ACTIVO=1
ZONA_HORARIA=Europe/Madrid
